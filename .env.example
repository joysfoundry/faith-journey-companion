# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Two prefixes, two very different behaviours:
#
#   VITE_*  — INLINED INTO THE CLIENT BUNDLE at build time. Every visitor can read
#             these in DevTools. Only ever put public-by-design values here.
#   (bare)  — server-side only, read via `process.env`. Never shipped to the browser.
#             This is where real secrets go.
#
# src/integrations/supabase/client.ts resolves each value as
#   import.meta.env['VITE_FOO'] || process.env['FOO']
# so the bare pair is the SSR fallback for the VITE_ pair. In production Lovable
# Cloud injects these; locally they come from your `.env`.

# ---------------------------------------------------------------------------
# Supabase — public. The "publishable" key is public by design, guarded by RLS.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase — SECRET. Bypasses RLS entirely. Server-side only; note there is
# deliberately no VITE_ twin, because inlining this would hand every visitor
# full read/write on the database.
#
# Only needed locally if you want the ACTS-94 share links (/follow) to work —
# src/lib/prayer/share.functions.ts reads/writes `shared_sessions` through it.
# Leave blank otherwise; share creation will throw a clear "Missing Supabase
# environment variable(s)" error and nothing else is affected.
#
# In production this is set in Lovable Cloud's env/secrets UI, never in a file.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Private-beta soft gate (src/components/beta-gate.tsx). Leave EMPTY to disable
# the passcode step entirely — handy for local work.
#
# Not a security control: being VITE_-prefixed it ships in the bundle, so it
# keeps casual visitors out, not determined ones.
# ---------------------------------------------------------------------------
VITE_BETA_PASSCODE=
